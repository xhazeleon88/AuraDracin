{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aura-dracin",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": true,
  "placement": {
    "mode": "smart"
  },
  "cache": {
    "enabled": true
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "aura-dracin"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "ai": {
    "binding": "AI"
  },
  "media": {
    "binding": "MEDIA"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.2
  },
  "vars": {
    "CLOUDFLARE_WORKERS": "1",
    "SUBTITLES_MODE": "workers-ai",
    "DRAMABOS_BASE_URL": "https://api.dramabuzz.sbs",
    "DRAMABOS_DEFAULT_PROVIDER": "reelshort",
    "DRAMABOS_LANG": "id",
    "ADMIN_EMAIL": "admin@auradracin.com",
    "HOME_CACHE_TTL_SEC": "120",
    "AUTH_URL": "https://aura-dracin.seo1-c33.workers.dev",
    "NEXT_PUBLIC_SITE_URL": "https://aura-dracin.seo1-c33.workers.dev"
  },
  "kv_namespaces": [
    {
      "binding": "AURA_CACHE",
      "id": "996c7c9ae8a24a2c993f32361a78c3a9"
    },
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "a4dcac053ebc4fb5b5bb6b38f447b8ce"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aura-dracin",
      "database_id": "7ac79b61-8bcf-40d6-8cea-7f0d60f04d98",
      "migrations_dir": "migrations"
    }
  ]
}
