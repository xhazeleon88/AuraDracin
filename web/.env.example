DATABASE_URL="file:./data/aura-dracin.db"
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# DramaBuzz access code from https://api.dramabuzz.sbs
# Docs reference: https://dramabos.live/docs
DRAMABOS_API_KEY=""
DRAMABOS_BASE_URL="https://api.dramabuzz.sbs"
DRAMABOS_DEFAULT_PROVIDER="reelshort"
DRAMABOS_LANG="id"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

ADMIN_EMAIL="admin@auradracin.com"
ADMIN_PASSWORD="admin123456"

# Cloudflare Workers (set via wrangler vars / secrets)
# CLOUDFLARE_WORKERS=1
# SUBTITLES_MODE=cache-only
# Set secrets: AUTH_SECRET, DRAMABOS_API_KEY, ADMIN_PASSWORD
# npx wrangler secret put AUTH_SECRET
# npx wrangler secret put DRAMABOS_API_KEY
# npx wrangler secret put ADMIN_PASSWORD
